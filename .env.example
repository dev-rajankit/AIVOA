# =============================================================================
# AIVOA Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# =============================================================================

# --- Database ---
# PostgreSQL connection string (async driver for FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aivoa

# --- LLM (Groq) ---
# Your Groq API key (https://console.groq.com)
GROQ_API_KEY=

# Model for fast extraction tasks (structured output, high throughput)
EXTRACTION_MODEL=openai/gpt-oss-20b

# Model for reasoning tasks (risk assessment, CAPA, root cause analysis)
REASONING_MODEL=openai/gpt-oss-120b

# --- Application ---
# Environment: development | staging | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
